server {
  listen 80;
  root /usr/share/nginx/html;

  # SSE streams: disable buffering and keep long-lived connections open
  location /events/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Connection '';
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
  }

  location ~ ^/(auth|rides|admin|drivers|health)(/|$) {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  # Hashed build assets can be cached forever
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # SPA: unknown paths fall back to index.html for react-router
  location / {
    try_files $uri /index.html;
  }
}
