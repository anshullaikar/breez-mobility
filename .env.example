# Copy to .env for local development (docker compose sets these itself)

# Postgres connection string used by Prisma
DATABASE_URL=postgresql://breez:breez@localhost:5432/breez

# Redis for geo index, online status, OTPs, idempotency keys, pub/sub
REDIS_URL=redis://localhost:6379

# Signs session JWTs. Required in production; generate with: openssl rand -hex 32
JWT_SECRET=change-me

# development returns OTP codes in the /auth/send-otp response (no WhatsApp integration yet)
NODE_ENV=development

PORT=3000

# Comma-separated allowed origins. Leave unset in dev to allow all.
# CORS_ORIGIN=https://app.example.com
